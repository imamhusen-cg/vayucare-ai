# ── Frontend (Vite) ────────────────────────────────────────────────
# No API keys here — all secrets stay on the backend server

# ── Backend Server (server/.env) ──────────────────────────────────
# Copy this block to server/.env and fill in your keys

# WAQI API Token (free at https://aqicn.org/data-platform/token/)
WAQI_API_TOKEN=your_waqi_api_token_here

# Google Gemini API Key (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default 3001)
PORT=3001
